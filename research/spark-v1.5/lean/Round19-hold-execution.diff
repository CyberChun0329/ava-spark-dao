+/-- The same payment part is continuously held up to its first unheld moment. -/
+def HoldHistory.firstUnheldFrom (history : HoldHistory) (a : ReviewAuthorities) (facts : HoldFacts)
+    (part : PaymentPartRef) (start releasedAt : Moment) : Prop :=
+  start.by releasedAt ∧ ¬history.paymentOnHold a facts part releasedAt ∧
+    ∀ time, start.by time → time.before releasedAt → history.paymentOnHold a facts part time
+
+/-- The complete release follows a recorded formal lift. Another hold may end later. -/
+def HoldHistory.paymentReleasedAt (history : HoldHistory) (a : ReviewAuthorities) (facts : HoldFacts)
+    (part : PaymentPartRef) (releasedAt : Moment) : Prop :=
+  ∃ hold lift, history.releasesPart a facts hold lift part ∧
+    history.firstUnheldFrom a facts part lift.effectiveAt releasedAt
+
